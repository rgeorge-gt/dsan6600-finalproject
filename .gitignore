cat > .gitignore <<'EOF'
# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Large project data
data/raw/*.parquet
data/processed/

# Model checkpoints
*.pt
*.pth
*.ckpt

# Tool caches
.pytest_cache/
.mypy_cache/
EOF
